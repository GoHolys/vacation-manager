{
  "name": "@vacation-manager/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Vacation Manager REST API — Common Event Framework + CQRS + TypeORM/PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "codegen": "cef-gen-handlers",
    "predev": "npm run codegen",
    "dev": "tsx watch --clear-screen=false src/index.ts --local",
    "build": "npm run codegen && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js --local",
    "typecheck": "npm run codegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "db:migrate": "tsx src/infrastructure/database/cli.ts migrate",
    "db:revert": "tsx src/infrastructure/database/cli.ts revert",
    "db:seed": "tsx src/infrastructure/database/cli.ts seed",
    "db:reset": "tsx src/infrastructure/database/cli.ts reset"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "commoneventframework": "^1.0.19",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
