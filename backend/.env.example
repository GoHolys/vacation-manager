# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origin allowed by CORS (also read by the Common Event Framework `Response` class).
FRONT_END_URL=http://localhost:5173
# IANA time zone used to decide what "today" is (business rule: no requests in the past).
APP_TIMEZONE=UTC

# ─── PostgreSQL (matches docker-compose.yml) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=vacation
DB_PASSWORD=vacation
DB_NAME=vacation_manager
DB_SSL=false
DB_LOGGING=false
# Database used by `npm run test:e2e` — it is wiped on every run.
DB_TEST_NAME=vacation_manager_test

# ─── Authentication ───────────────────────────────────────────────────────────
# Use a long random value in any shared environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
